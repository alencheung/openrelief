# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Database Connection Pool Configuration
DB_POOL_MIN=10
DB_POOL_MAX=100
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000
DB_POOL_ACQUIRE_TIMEOUT=3000

# Supabase Connection Pooler (Supavisor)
SUPABASE_POOLER_URL=

# Read Replica Configuration (optional)
SUPABASE_REPLICA_URL=
SUPABASE_REPLICA_SERVICE_KEY=

# Edge Functions
EDGE_FUNCTION_URL=https://your-project.supabase.co/functions/v1

# Maps
NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-api-key
NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json

# Notifications
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id

# Push Notifications (Web Push via VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@openrelief.org

# Monitoring
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-public-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# AI/ML
OPENAI_API_KEY=your-openai-api-key

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_OFFLINE_SYNC=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_TRUST_SYSTEM=true

# Environment
NEXT_PUBLIC_ENVIRONMENT=development
NODE_ENV=development

# Security
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Performance
NEXT_PUBLIC_BUNDLE_ANALYZER=false

# Development
NEXT_PUBLIC_DEBUG_MODE=false

# Redis (Upstash) - for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth (Supabase Auth provider)
# Configure in Supabase Dashboard > Authentication > Providers > Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Workers (Edge Functions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=