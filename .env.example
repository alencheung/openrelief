# OpenRelief Environment Variables
#
# Copy this file to `.env.local` and fill in the values.
# Only the Supabase variables are required; everything else is optional.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key from Supabase project settings
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Redis (optional) - for caching and rate limiting
# ---------------------------------------------------------------------------
# Direct Redis connection string (self-hosted or managed Redis)
REDIS_URL=

# Upstash Redis REST API (alternative to REDIS_URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Security (optional - recommended in production)
# ---------------------------------------------------------------------------
# Secret pepper applied to password hashing for additional protection
AUTH_PEPPER=

# Secret used to sign JWTs for session management
JWT_SECRET=

# ---------------------------------------------------------------------------
# Monitoring (optional)
# ---------------------------------------------------------------------------
# Sentry DSN for client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for uploading source maps during builds
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Web Push (optional - required for server-side push delivery)
# ---------------------------------------------------------------------------
# VAPID public key (exposed to the browser for subscription)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID private key (server-side only)
VAPID_PRIVATE_KEY=

# VAPID subject contact (defaults to mailto:noreply@openrelief.org)
VAPID_SUBJECT=mailto:noreply@openrelief.org

# ---------------------------------------------------------------------------
# Maps (optional)
# ---------------------------------------------------------------------------
# MapTiler API key for map tiles. Without it the map falls back to a 403 placeholder.
NEXT_PUBLIC_MAPTILER_API_KEY=

# ---------------------------------------------------------------------------
# App (optional)
# ---------------------------------------------------------------------------
# Public application URL (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
